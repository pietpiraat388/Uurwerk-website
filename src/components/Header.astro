---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import { GUIDES, NAV_LINKS, SITE, guideUrl } from '../lib/site';

interface Props {
  /** Op gidsen en tools neemt de sticky download-balk de downloadknop over op mobiel. */
  stickyBar?: boolean;
}

const { stickyBar = false } = Astro.props;
const path = Astro.url.pathname;
const guidePaths = GUIDES.map((guide) => guideUrl(guide.slug));

// Welk menu-item hoort bij deze pagina? Exacte pagina's eerst, anders valt een gids onder "Gidsen".
const activeHref =
  NAV_LINKS.find((link) => link.href === path)?.href ??
  (guidePaths.includes(path) ? '/#gidsen' : undefined);
---

<header class:list={['site-header', { 'has-sticky-bar': stickyBar }]} data-placement="header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Uurwerk homepage">
      <Image src={appIcon} alt="" width={32} height={32} class="brand-icon" loading="eager" />
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav class="site-nav" id="site-navigation" aria-label="Hoofdnavigatie">
      <ul>
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={{ 'is-active': link.href === activeHref }}
              aria-current={link.href === path ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn-primary btn-pill nav-cta" href={SITE.appStoreUrl} rel="noopener">Download</a>
      <button type="button" class="nav-toggle" aria-label="Menu openen" aria-expanded="false" aria-controls="site-navigation">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const navigation = document.querySelector<HTMLElement>('#site-navigation');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
    navigation?.setAttribute('data-open', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  navigation?.addEventListener('click', (event) => { if (event.target instanceof Element && event.target.closest('a')) setOpen(false); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); } });
</script>
<noscript><style>.nav-toggle{display:none!important}@media(max-width:899px){.header-inner{height:auto!important;flex-wrap:wrap;padding-block:12px}.site-nav{display:block!important;position:static!important;width:100%;box-shadow:none!important;border:0!important;padding:0!important}}</style></noscript>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 248, 243, 0.88);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    height: 72px;
  }

  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1875rem;
    letter-spacing: -0.016em;
    line-height: 1.1;
    text-decoration: none;
    border-radius: 8px;
  }

  .brand:hover {
    color: var(--ink);
  }

  :global(.brand-icon) {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    box-shadow: 0 2px 6px rgba(67, 96, 79, 0.15);
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav li {
    margin: 0;
  }

  .site-nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 0.90625rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    transition: background-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
  }

  .site-nav a:hover {
    color: var(--ink);
    background: var(--sand);
  }

  .site-nav a.is-active {
    background: var(--sage-faint);
    color: var(--sage-deep);
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 22px;
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.2s var(--ease-out), opacity 0.2s var(--ease-out);
  }

  .nav-toggle:hover {
    background: var(--sand);
  }

  @media (max-width: 899px) {
    .header-inner {
      display: flex;
      justify-content: space-between;
      height: 64px;
      padding-left: 20px;
      padding-right: 14px;
    }

    .brand {
      font-size: 1.125rem;
    }

    :global(.brand-icon) {
      width: 30px;
      height: 30px;
    }

    .nav-cta {
      min-height: 38px;
      padding: 0 16px;
      font-size: 0.875rem;
    }

    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      padding: 8px 20px 20px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 48px -24px rgba(30, 41, 33, 0.25);
    }

    .site-nav[data-open='true'] {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav a {
      padding: 14px 4px;
      border-radius: 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.0625rem;
      color: var(--ink);
    }

    .site-nav li:last-child a {
      border-bottom: 0;
    }

    .site-nav a:hover,
    .site-nav a.is-active {
      background: transparent;
      color: var(--sage-deep);
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }

  /* Gidsen en tools: sticky download-balk vervangt de downloadknop in de header */
  @media (max-width: 767px) {
    .has-sticky-bar .nav-cta {
      display: none;
    }
  }
</style>
