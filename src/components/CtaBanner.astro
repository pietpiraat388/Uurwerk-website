---
import AppStoreButton from './AppStoreButton.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Begin vandaag met uren bijhouden',
  text = 'Registreer je uren met een timer of handmatige invoer en houd overzicht per klant en project. Urenregistratie en conceptfacturen zijn gratis; voor facturen versturen is Pro nodig.',
} = Astro.props;
---

<section class="section cta-section" data-placement="bottom-cta">
  <div class="container">
    <div class="card card-ink cta-card">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta-actions">
        <AppStoreButton />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding: clamp(2rem, 5vw, 3.25rem);
  }

  .cta-card h2 {
    margin-bottom: 0.5rem;
  }

  .cta-card p {
    max-width: 52ch;
    margin: 0;
  }

  .cta-actions {
    flex-shrink: 0;
  }
</style>
