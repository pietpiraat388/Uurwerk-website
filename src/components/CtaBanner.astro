---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import AppStoreButton from './AppStoreButton.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Begin vandaag met uren bijhouden',
  text = 'Registreer je uren met een timer of handmatige invoer en houd overzicht per klant en project. Urenregistratie en conceptfacturen zijn gratis; voor facturen versturen is Pro nodig.',
} = Astro.props;
---

<section class="cta-section" data-placement="bottom-cta">
  <div class="container cta-inner" data-reveal>
    <Image src={appIcon} alt="" width={88} height={88} class="cta-icon" loading="lazy" />
    <h2>{title}</h2>
    <p>{text}</p>
    <AppStoreButton size="xl" />
  </div>
</section>

<style>
  .cta-section {
    background: var(--sage-faint);
    padding: 128px 0;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  :global(.cta-icon) {
    width: 88px;
    height: 88px;
    border-radius: 20px;
    border: 1px solid rgba(30, 41, 33, 0.08);
    box-shadow: 0 10px 24px -8px rgba(67, 96, 79, 0.25);
  }

  h2 {
    max-width: 640px;
    margin: 28px 0 16px;
    font-size: clamp(1.875rem, 4.6vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  p {
    max-width: 640px;
    margin: 0 0 36px;
    color: var(--ink-2);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  @media (max-width: 767px) {
    .cta-section {
      padding: 88px 0;
    }

    :global(.cta-icon) {
      width: 72px;
      height: 72px;
      border-radius: 16px;
    }

    h2 {
      margin: 24px 0 14px;
      line-height: 1.12;
    }

    p {
      margin-bottom: 28px;
      font-size: 1.03125rem;
    }
  }
</style>
