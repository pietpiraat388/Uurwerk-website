const { name, size = 20, class: className } = Astro.props;
---

{
  name === 'apple' ? (
    <svg class={className} width={size} height={size} viewBox="0 0 14 14" fill="currentColor" aria-hidden="true" focusable="false">
      <path fill-rule="evenodd" d={APPLE} />
