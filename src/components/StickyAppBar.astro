---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import { SITE } from '../lib/site';
import Icon from './Icon.astro';
---

<aside class="sticky-app-bar" aria-label="Uurwerk downloaden" data-placement="guide-sticky-bar">
  <Image src={appIcon} alt="" width={42} height={42} class="sticky-icon" loading="lazy" />
  <div class="sticky-text">
    <strong>Uurwerk voor iPhone</strong>
    <span>Gratis te downloaden.</span>
  </div>
  <a class="sticky-button" href={SITE.appStoreUrl} rel="noopener">
    <Icon name="apple" size={16} />
    Download
  </a>
</aside>

<script>
  // Verberg de balk zolang het schermtoetsenbord open staat (visual viewport krimpt sterk).
  const bar = document.querySelector<HTMLElement>('.sticky-app-bar');
  const viewport = window.visualViewport;
  if (bar && viewport) {
    const update = () => bar.toggleAttribute('data-keyboard', viewport.height < window.innerHeight * 0.75);
    viewport.addEventListener('resize', update);
  }
</script>

<style>
  .sticky-app-bar {
    display: none;
  }

  @media (max-width: 767px) {
    .sticky-app-bar {
      position: fixed;
      left: 14px;
      right: 14px;
      bottom: calc(14px + env(safe-area-inset-bottom));
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px;
      background: rgba(255, 255, 255, 0.88);
      -webkit-backdrop-filter: blur(24px);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(30, 41, 33, 0.08);
      border-radius: 22px;
      box-shadow: 0 12px 32px -8px rgba(30, 41, 33, 0.2), 0 1px 3px rgba(30, 41, 33, 0.06);
      animation: sticky-fade 0.2s var(--ease-out) both;
    }

    .sticky-app-bar[data-keyboard] {
      display: none;
    }

    :global(body:has(.sticky-app-bar)) {
      padding-bottom: 96px;
    }
  }

  :global(.sticky-icon) {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 10px;
  }

  .sticky-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    flex: 1;
  }

  .sticky-text strong {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.013em;
    color: var(--ink);
  }

  .sticky-text span {
    font-size: 0.78125rem;
    color: var(--ink-3);
  }

  .sticky-button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 44px;
    padding: 0 16px;
    background: var(--sage);
    color: #fff;
    border-radius: 14px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s var(--ease-out);
  }

  .sticky-button:hover {
    background: var(--sage-deep);
    color: #fff;
  }

  @keyframes sticky-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-app-bar {
      animation: none;
    }
  }
</style>
