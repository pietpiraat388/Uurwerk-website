---
import type { FaqEntry } from '../lib/schema';
import { plainText } from '../lib/schema';

interface Props {
  entries: FaqEntry[];
}

const { entries } = Astro.props;
---

<div class="faq-list">
  {entries.map((entry) => (
    <details class="faq-item">
      <summary>{plainText(entry.question)}</summary>
      <div class="faq-answer">
        <p set:html={entry.answer} />
      </div>
    </details>
  ))}
</div>
