---
import { SITE } from '../lib/site';
import Icon from './Icon.astro';

interface Props {
  variant?: 'badge' | 'primary';
  label?: string;
  /** Hoogte van de badge: md = 52px, lg = 56px, xl = 58px */
  size?: 'md' | 'lg' | 'xl';
}

const { variant = 'badge', label = 'Download in de App Store', size = 'md' } = Astro.props;
---

{
  variant === 'badge' ? (
    <a class:list={['appstore-badge', `appstore-${size}`]} href={SITE.appStoreUrl} rel="noopener">
      <Icon name="apple" size={24} class="appstore-logo" />
      <span class="appstore-badge-text">
        <small>Download in de</small>
        App Store
      </span>
    </a>
  ) : (
    <a class="btn btn-primary" href={SITE.appStoreUrl} rel="noopener">
      {label}
    </a>
  )
}

<style>
  .appstore-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 18px 0 14px;
    background: var(--appstore);
    color: #fff;
    border-radius: 14px;
    line-height: 1.05;
    text-decoration: none;
    transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out);
  }

  .appstore-lg {
    height: 56px;
    padding: 0 22px 0 18px;
  }

  .appstore-xl {
    height: 58px;
    padding: 0 24px 0 20px;
  }

  .appstore-badge:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 10px 22px -10px rgba(17, 20, 18, 0.55);
  }

  .appstore-badge-text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .appstore-badge-text small {
    font-family: var(--font-stack);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .appstore-badge:hover {
      transform: none;
    }
  }
</style>
