---
import { PRODUCT_FEATURES, PRO_PRICING, SITE } from '../lib/site';
---
<div class="table-scroll">
  <table>
    <caption>Gratis functies en Uurwerk Pro</caption>
    <thead><tr><th scope="col">Functie</th><th scope="col">Gratis</th><th scope="col">Met Pro</th></tr></thead>
    <tbody>{PRODUCT_FEATURES.map((feature) => <tr><th scope="row">{feature.label}</th><td>{feature.free ? 'Inbegrepen' : 'Pro nodig'}</td><td>Inbegrepen</td></tr>)}</tbody>
  </table>
</div>
<dl class="product-facts">
  <div><dt>Pro per maand</dt><dd><strong>{PRO_PRICING.monthlyLabel}</strong> per maand.</dd></div>
  <div><dt>Pro per jaar</dt><dd><strong>{PRO_PRICING.yearlyLabel}</strong> per jaar, in één keer betaald. Ongeveer {PRO_PRICING.yearlyMonthlyLabel} per maand; {PRO_PRICING.yearlySavingPercent}% goedkoper dan twaalf maandbetalingen.</dd></div>
</dl>
<p class="download-note">Uren registreren en conceptfacturen maken zijn gratis. Pro is nodig voor facturen versturen. Prijzen bevestigd op 19 september 2026. Controleer vóór aankoop de voorwaarden in de app. <a href={SITE.appStoreUrl}>Bekijk Uurwerk in de App Store</a>.</p>
