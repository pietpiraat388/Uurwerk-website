---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import { GUIDES, SITE, guideUrl } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <Image src={appIcon} alt="" width={44} height={44} class="footer-icon" />
          <span>{SITE.name}</span>
        </a>
        <p>
          Eenvoudige urenregistratie voor zzp&rsquo;ers, freelancers en kleine ondernemers.
          Gemaakt in Nederland door {SITE.publisher}.
        </p>
        <a class="btn btn-inverse" href={SITE.appStoreUrl} rel="noopener">
          Download in de App Store
        </a>
      </div>

      <nav aria-label="Website">
        <h3>Website</h3>
        <ul>
          <li><a href="/#functies">Functies</a></li>
          <li><a href="/#hoe-het-werkt">Hoe het werkt</a></li>
          <li><a href="/#screenshots">Screenshots</a></li>
          <li><a href="/#faq">Veelgestelde vragen</a></li>
          <li><a href={SITE.appStoreUrl} rel="noopener">App Store</a></li>
        </ul>
      </nav>

      <nav aria-label="Gidsen" class="footer-guides">
        <h3>Gidsen over urenregistratie</h3>
        <ul>
          {GUIDES.map((guide) => (
            <li><a href={guideUrl(guide.slug)}>{guide.navTitle}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Officiele bronnen">
        <h3>Offici&euml;le bronnen</h3>
        <ul>
          <li>
            <a href="https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/winst/inkomstenbelasting/inkomstenbelasting_voor_ondernemers/ondernemersaftrek/" rel="noopener nofollow">
              Belastingdienst: ondernemersaftrek
            </a>
          </li>
          <li>
            <a href="https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/winst/inkomstenbelasting/inkomstenbelasting_voor_ondernemers/voorwaarden_urencriterium" rel="noopener nofollow">
              Belastingdienst: urencriterium
            </a>
          </li>
          <li>
            <a href="https://www.kvk.nl/" rel="noopener nofollow">KVK</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {SITE.publisher} &middot; {SITE.fullName}</p>
      <p>
        Uurwerk is een onafhankelijke app en niet verbonden aan de Belastingdienst of andere
        genoemde organisaties.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, var(--ink-900), var(--ink-950));
    color: var(--text-inverse-muted);
    padding: clamp(3rem, 7vw, 4.5rem) 0 2rem;
    margin-top: clamp(3rem, 8vw, 5rem);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1.2fr;
    gap: clamp(1.8rem, 4vw, 3rem);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #fff;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.9rem;
  }

  .brand:hover {
    text-decoration: none;
  }

  :global(.footer-icon) {
    border-radius: 11px;
  }

  .footer-brand p {
    max-width: 34ch;
    margin-bottom: 1.4rem;
  }

  h3 {
    color: #fff;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin-bottom: 0.55rem;
  }

  footer a:not(.brand):not(.btn) {
    color: var(--text-inverse-muted);
    font-size: 0.95rem;
  }

  footer a:not(.brand):not(.btn):hover {
    color: #fff;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: clamp(2rem, 5vw, 3rem);
    padding-top: 1.5rem;
    font-size: 0.85rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    margin: 0;
  }
</style>
