---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import { GUIDES, SITE, guideUrl } from '../lib/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-placement="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <Image src={appIcon} alt="" width={36} height={36} class="footer-icon" />
          <span>{SITE.name}</span>
        </a>
        <p>
          Eenvoudige urenregistratie voor zzp&rsquo;ers, freelancers en kleine ondernemers.
          Gemaakt in Nederland door {SITE.publisher}.
        </p>
        <a class="footer-download" href={SITE.appStoreUrl} rel="noopener">
          <Icon name="apple" size={15} />
          Download in de App Store
        </a>
      </div>

      <nav aria-label="Website" class="footer-site">
        <h3>Website</h3>
        <ul>
          <li><a href="/#functies">Functies</a></li>
          <li><a href="/#hoe-het-werkt">Hoe het werkt</a></li>
          <li><a href="/#screenshots">Screenshots</a></li>
          <li><a href="/#faq">Veelgestelde vragen</a></li>
          <li><a href="/over-uurwerk/">Over Uurwerk</a></li>
          <li><a href="/contact/">Contact en ondersteuning</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/urenregistratie-app-gratis/">Gratis en Uurwerk Pro</a></li>
          <li><a href={SITE.appStoreUrl} rel="noopener">App Store</a></li>
        </ul>
      </nav>

      <nav aria-label="Gidsen" class="footer-guides">
        <h3>Gidsen over urenregistratie</h3>
        <ul>
          {GUIDES.map((guide) => (
            <li><a href={guideUrl(guide.slug)}>{guide.navTitle}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Officiele bronnen" class="footer-sources">
        <h3>Offici&euml;le bronnen</h3>
        <ul>
          <li>
            <a href="https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/winst/inkomstenbelasting/inkomstenbelasting_voor_ondernemers/ondernemersaftrek/" rel="noopener nofollow">
              Belastingdienst: ondernemersaftrek
            </a>
          </li>
          <li>
            <a href="https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/winst/inkomstenbelasting/inkomstenbelasting_voor_ondernemers/voorwaarden_urencriterium" rel="noopener nofollow">
              Belastingdienst: urencriterium
            </a>
          </li>
          <li>
            <a href="https://www.kvk.nl/" rel="noopener nofollow">KVK</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {SITE.publisher} &middot; {SITE.fullName}</p>
      <p>
        Uurwerk is een onafhankelijke app en niet verbonden aan de Belastingdienst of andere
        genoemde organisaties.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--line);
    padding: 80px 0 48px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 300px 260px minmax(0, 1fr);
    grid-template-areas:
      'brand site guides'
      'brand sources guides';
    grid-template-rows: auto 1fr;
    column-gap: 40px;
    row-gap: 40px;
  }

  .footer-brand {
    grid-area: brand;
  }

  .footer-site {
    grid-area: site;
  }

  .footer-guides {
    grid-area: guides;
  }

  .footer-sources {
    grid-area: sources;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  :global(.footer-icon) {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(67, 96, 79, 0.15);
  }

  .footer-brand p {
    margin: 16px 0;
    color: var(--ink-2);
    font-size: 0.90625rem;
    line-height: 1.6;
  }

  .footer-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.15s var(--ease-out);
  }

  .footer-download:hover {
    background: var(--sand);
    color: var(--ink);
  }

  h3 {
    margin: 0 0 12px;
    font-family: var(--font-stack);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin: 0 0 12px;
    font-size: 0.90625rem;
    line-height: 1.4;
  }

  .footer-guides ul {
    columns: 2;
    column-gap: 24px;
  }

  .footer-guides li {
    break-inside: avoid;
  }

  nav a {
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    margin-top: 44px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 959px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'brand brand'
        'site sources'
        'guides guides';
      grid-template-rows: auto;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      padding: 64px 0 40px;
    }

    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'brand'
        'site'
        'guides'
        'sources';
    }

    .footer-bottom {
      flex-direction: column;
      gap: 8px;
      margin-top: 40px;
    }

    .footer-bottom p:last-child {
      line-height: 1.55;
    }
  }
</style>
