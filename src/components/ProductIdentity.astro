---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import { SITE, PRO_PRICING } from '../lib/site';

interface Props {
  /** card = zandkaart in gidsen, plain = leeskolom op de homepage */
  variant?: 'card' | 'plain';
}

const { variant = 'card' } = Astro.props;
---
<section class:list={['product-identity', `product-identity-${variant}`]} aria-labelledby="about-product">
  <div class="identity-head">
    {variant === 'card' && <Image src={appIcon} alt="" width={36} height={36} class="identity-icon" loading="lazy" />}
    <h2 id="about-product">Wat is Urenregistreren.com?</h2>
  </div>
  <p>
    Urenregistreren.com is de officiële website van <strong>Uurwerk</strong>, een
    Nederlandstalige urenregistratie-app voor iPhone. Zzp’ers, freelancers en kleine
    ondernemers registreren er hun eigen werkuren per klant en project met een timer
    of handmatige invoer. Van openstaande uren kunnen zij conceptfacturen maken.
  </p>
  <p>
    Urenregistratie, klanten, projecten en conceptfacturen zijn gratis.
    Voor facturen versturen is Uurwerk Pro nodig: {PRO_PRICING.monthlyLabel} per maand
    of {PRO_PRICING.yearlyLabel} per jaar. Uurwerk heeft geen medewerkersaccounts of
    goedkeuring van uren. De app is gemaakt door{' '}
    <a href="/over-uurwerk/">{SITE.developer}</a>.
    Bekijk de <a href={SITE.appStoreUrl}>officiële App Store-vermelding</a>{' '}
    en het <a href="/urenregistratie-app-gratis/">overzicht van gratis en Pro</a>.
  </p>
</section>
<style>
  .product-identity {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .product-identity p {
    margin: 0;
    color: var(--ink-2);
  }

  .product-identity strong {
    font-weight: inherit;
    color: inherit;
  }

  .identity-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .identity-head h2 {
    margin: 0;
  }

  .product-identity-card {
    padding: 30px 32px;
    background: var(--sand);
    border-radius: 22px;
  }

  .product-identity-card h2 {
    font-size: 1.375rem;
    line-height: 1.1;
    letter-spacing: -0.023em;
  }

  .product-identity-card p {
    font-size: 1rem !important;
    line-height: 1.65 !important;
  }

  :global(.identity-icon) {
    width: 36px;
    height: 36px;
    border-radius: 8px;
  }

  .product-identity-plain {
    gap: 22px;
  }

  .product-identity-plain h2 {
    font-size: clamp(1.625rem, 3.2vw, 2.125rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .product-identity-plain p {
    font-size: clamp(1.03125rem, 1.5vw, 1.125rem);
    line-height: 1.7;
  }

  @media (max-width: 767px) {
    .product-identity-card {
      padding: 22px 20px;
    }

    .product-identity-plain {
      gap: 18px;
    }
  }
</style>
