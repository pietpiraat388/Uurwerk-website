const faq: FaqEntry[] = [
  { question: 'Is urenregistratie voor personeel verplicht?', answer: `Volgens het Arboportaal moet een werkgever gewerkte uren registreren, zodat de Nederlandse Arbeidsinspectie kan controleren of de Arbeidstijdenwet wordt nageleefd. Er is geen verplicht vormgevingsformat. Controleer de toepasselijke regels voor je werknemers en sector bij het <a href="${source}">Arboportaal</a>.` },
  { question: 'Is een werkrooster hetzelfde als een urenregistratie?', answer: 'Een rooster laat zien wanneer iemand volgens de planning werkt. Een urenregistratie legt de feitelijke werktijden vast. Als iemand eerder begint, langer doorwerkt of een andere pauze neemt, moet je die afwijking kunnen verwerken.' },
  { question: 'Welke functies zijn belangrijk in een urenregistratie-app voor personeel?', answer: 'Controleer medewerkersaccounts, toegangsrechten, begin- en eindtijden, pauzes, correcties en goedkeuring. Kijk daarnaast welke gegevens je nodig hebt voor salarisverwerking en of een export of koppeling die werkelijk aanlevert.' },
