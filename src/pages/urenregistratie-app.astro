---
import Guide from '../layouts/Guide.astro';
import { PRO_PRICE_ANSWER } from '../lib/site';
import type { FaqEntry } from '../lib/schema';
import InvoiceSteps from '../components/InvoiceSteps.astro';
import ProductIdentity from '../components/ProductIdentity.astro';

const faq: FaqEntry[] = [
  { question: 'Wat is een goede urenregistratie-app?', answer: 'Een goede urenregistratie-app laat je snel tijd vastleggen, fouten corrigeren en je uren per klant of project terugvinden. Kies op je eigen apparaat, factuurbehoefte en budget. Uurwerk past bij zelfstandig registreren op iPhone; voor Android of gezamenlijke personeelsregistratie heb je een andere oplossing nodig.' },
  { question: 'Werkt Uurwerk op Android of in de browser?', answer: 'Uurwerk wordt aangeboden als iPhone-app. Deze website biedt uitleg en hulpmiddelen, geen browseromgeving om je app-uren te beheren. Een Android-versie wordt hier niet aangeboden.' },
  { question: 'Hoe kies je een tool die uren direct omzet in facturen?', answer: 'Controleer of uren aan een klant en tarief gekoppeld zijn, je openstaande uren kunt selecteren en de factuur vóór verzending kunt controleren. Kijk ook naar btw, PDF-uitvoer en de kosten van versturen. Uurwerk maakt gratis conceptfacturen; voor versturen vanuit de app is Pro nodig.' },
  {
    question: 'Wat kost een urenregistratie app?',
    answer:
      PRO_PRICE_ANSWER,
  },
  {
    question: 'Wat is de eenvoudigste urenregistratie app voor iPhone?',
    answer:
      'De eenvoudigste app is de app die je daadwerkelijk elke dag gebruikt: snel starten, uren invoeren in een paar tikken en direct overzicht. Uurwerk is met dat doel gemaakt: een timer, handmatige invoer en overzichten per klant, zonder boekhoudmodules die je niet nodig hebt.',
  },
  {
    question: 'Kan ik met een urenregistratie app ook factureren?',
    answer:
      'Sommige apps registreren alleen tijd, andere zetten je uren ook om in een factuur. Uurwerk doet dat laatste: je kiest de openstaande uren van een klant en de app maakt er een conceptfactuur met btw van, die je als PDF kunt exporteren.',
  },
  {
    question: 'Is een app beter dan Excel voor urenregistratie?',
    answer:
      'Een app is handig als je een timer en vaste klant- en projectvelden wilt. Excel geeft meer vrijheid in de indeling; je controleert zelf formules en bestanden. Bij beide moet je consequent registreren. Bekijk de vergelijking en gratis template bij <a href="/urenregistratie-excel/">urenregistratie in Excel</a>.',
  },
];
---

<Guide
  slug="urenregistratie-app"
  metaTitle="Urenregistratie app: zo kies je de juiste | Uurwerk"
  description="Kies een urenregistratie-app voor je werk. Vergelijk timer, klanturen, facturatie en kosten, met echte voorbeelden van Uurwerk voor iPhone."
  h1="Urenregistratie app: zo kies je de juiste"
  dateModified="2026-09-19"
  answer="Een urenregistratie app is een app waarmee je gewerkte uren vastlegt per klant of project, met een timer of handmatige invoer. Voor zzp&rsquo;ers en kleine ondernemers zijn de belangrijkste functies: snel uren invoeren, uren koppelen aan klanten en projecten, duidelijke overzichten en de mogelijkheid om uren om te zetten in een factuur."
  faq={faq}
>
  <h2>Wat is een goede urenregistratie-app voor jouw werk?</h2>
  <p>Controleer eerst of de app werkt op je telefoon en past bij je dagelijkse taken. Voer een echte werkdag in met twee klanten en een pauze. Kun je de tijd makkelijk corrigeren en zie je per klant het juiste totaal? Bepaal daarna of je ook facturen wilt maken of alleen een urenoverzicht nodig hebt. De <a href="/urenregistratie-software/">softwarevergelijking</a> helpt als je ook teamfuncties of een breder pakket overweegt.</p>
  <h2>Hoe kies je een tool die uren direct omzet in facturen?</h2>
  <p>Volg één opdracht van ureninvoer tot factuur. Zo zie je of de app je werkproces ondersteunt. Controleer deze punten voordat je je klanten en uren overzet:</p>
  <p class="comparison-hint">Schuif de tabel opzij om alle kolommen te bekijken.</p>
  <div class="table-scroll comparison-table" tabindex="0" role="region" aria-label="Selectiecriteria voor urenregistratie met facturen"><table><thead><tr><th scope="col">Controle</th><th scope="col">Waar je op let</th><th scope="col">In Uurwerk</th></tr></thead><tbody>
    <tr><th scope="row">Klant en tarief</th><td>Kan elke registratie bij de juiste klant en opdracht worden opgeslagen?</td><td>Klanten en projecten met tarieven.</td></tr>
    <tr><th scope="row">Openstaande uren</th><td>Zie je welke uren nog op de factuur moeten?</td><td>Openstaande uren kiezen voor een conceptfactuur.</td></tr>
    <tr><th scope="row">Controle en btw</th><td>Kun je regels, bedragen en btw controleren voordat je verstuurt?</td><td>Factuurvoorbeeld met regels, btw en totaal.</td></tr>
    <tr><th scope="row">Versturen en kosten</th><td>Welke handeling is gratis en wanneer betaal je?</td><td>Concepten gratis; voor versturen is Pro nodig.</td></tr>
    <tr><th scope="row">Apparaat en administratie</th><td>Werkt het op jouw apparaat en kun je je administratie bewaren?</td><td>iPhone-app met PDF-facturen. Controleer je eigen bewaar- en exportbehoefte.</td></tr>
  </tbody></table></div>
  <h3>Zo ziet uren factureren eruit in Uurwerk</h3>
  <InvoiceSteps />
  <p>Volg de <a href="/uren-factureren/">handleiding voor uren factureren</a> of bekijk <a href="/urenregistratie-app-gratis/">wat gratis is en waarvoor je Pro nodig hebt</a>.</p>
  <h2>Welke werkwijze past bij je?</h2>
  <p><strong>Een spreadsheet</strong> past bij wie zelf wil rekenen en een flexibel document nodig heeft. Begin met het <a href="/urenstaat-maken/#downloads">gratis urenstaatsjabloon</a>. <strong>Een lichte iPhone-app</strong> past bij zelfstandig werken met timer, klanten en facturen. Heb je teams, bankkoppelingen of een volledige boekhouding nodig, vergelijk dan een uitgebreider pakket op die functies.</p>
  <h2>Wat is een urenregistratie app?</h2>
  <p>
    Een urenregistratie app vervangt de papieren urenstaat of het Excel-bestand waarin je
    gewerkte uren bijhoudt. Je legt per werkdag vast hoeveel tijd je aan welke klant of welk
    project hebt besteed, meestal met een korte omschrijving van het werk. Goede apps rekenen
    daar direct een bedrag bij uit op basis van je uurtarief.
  </p>
  <p>
    Voor zelfstandigen heeft urenregistratie drie doelen: je weet wat je kunt factureren, je ziet
    waar je tijd naartoe gaat en je bouwt een administratie op waarmee je bijvoorbeeld
    het <a href="/urencriterium/">urencriterium</a> kunt onderbouwen richting de Belastingdienst.
  </p>

  <h2>Deze functies heb je echt nodig</h2>
  <ul>
    <li>
      <strong>Timer &eacute;n handmatige invoer.</strong> Een timer voor gefocust werk, handmatige
      invoer voor uren die je achteraf invult. Je wilt beide, want geen enkele werkdag is gelijk.
    </li>
    <li>
      <strong>Klanten en projecten.</strong> Een klant- of projectkoppeling maakt je uren later gemakkelijker terug te vinden en te factureren. Kies een app waarin je tarieven en btw per klant vastlegt.
    </li>
    <li>
      <strong>Overzichten per periode.</strong> Totaal uren en totaal bedrag per week of maand,
      zodat je facturen en administratie kloppen.
    </li>
    <li>
      <strong>Omschrijving per urenregel.</strong> Over drie maanden weet je niet meer wat
      &ldquo;3 uur, dinsdag&rdquo; was. Een omschrijving maakt je registratie controleerbaar.
    </li>
    <li>
      <strong>Van uren naar factuur.</strong> Als de app openstaande uren direct omzet in een
      factuur, sla je een complete handmatige stap over en vergeet je geen declarabele uren.
    </li>
  </ul>

  <h2>Wat je meestal niet nodig hebt</h2>
  <p>
    Veel urenregistratiesoftware is gebouwd voor teams en bedrijven: roosters, verlofregistratie,
    goedkeuringsflows en koppelingen met salarisadministratie. Werk je alleen of met een enkele
    opdrachtgever, dan betaal je daarmee voor complexiteit die je nooit gebruikt.
    Een <a href="/urenregistratie-zzp/">urenregistratie voor zzp&rsquo;ers</a> mag licht en simpel
    zijn.
  </p>

  <h2>Waar je op let bij het kiezen</h2>
  <ol>
    <li>
      <strong>Invoersnelheid.</strong> Uren invoeren moet in seconden kunnen, anders stel je het
      uit en klopt je registratie niet meer.
    </li>
    <li>
      <strong>Nederlandse begrippen.</strong> Btw-tarieven, urencriterium, factuureisen: een
      Nederlandstalige app die hierop is ingericht scheelt vertaalwerk en fouten.
    </li>
    <li>
      <strong>Overzicht zonder rapportendoolhof.</strong> E&eacute;n scherm met je uren en
      bedragen per periode is waardevoller dan twintig exporteerbare rapporten.
    </li>
    <li>
      <strong>Eerlijk prijsmodel.</strong> Controleer wat gratis is en waarvoor je betaalt,
      voordat je al je gegevens invoert.
    </li>
  </ol>

  <h2>Uurwerk als eenvoudig voorbeeld</h2>
  <p>
    Uurwerk is een Nederlandstalige urenregistratie app voor iPhone, gemaakt voor zzp&rsquo;ers,
    freelancers en kleine ondernemers. De app doet precies wat hierboven staat: uren registreren
    met timer of handmatige invoer, klanten en projecten met eigen uurtarief en btw, overzichten
    per week of maand en facturen maken van openstaande uren. Urenregistratie, klanten, projecten
    en conceptfacturen zijn gratis; alleen voor het versturen van facturen is Uurwerk Pro nodig.
  </p>
  <ProductIdentity />
</Guide>

