---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import PricingTable from '../components/PricingTable.astro';
import ProductIdentity from '../components/ProductIdentity.astro';
import { faqSchema, softwareApplicationSchema, websiteSchema } from '../lib/schema';
import { GUIDES, guideUrl } from '../lib/site';
import { HOME_FAQ as faqEntries } from '../lib/product-faq';

import appIcon from '../assets/app-icon.png';
import shotFactuur from '../assets/screenshots/screenshot-01.png';
import shotTimer from '../assets/screenshots/screenshot-02.png';
import shotKlanten from '../assets/screenshots/screenshot-03.png';
import shotUren from '../assets/screenshots/screenshot-04.png';
import shotInvoer from '../assets/screenshots/screenshot-05.png';
import shotPdf from '../assets/screenshots/screenshot-06.png';
import shotBetaal from '../assets/screenshots/screenshot-07.png';
import heroVandaag from '../assets/uurwerk-urenregistratie-app-vandaag-iphone.png';
import heroOverzicht from '../assets/uurwerk-urenoverzicht-maand-iphone.png';
import featureInvoer from '../assets/uurwerk-uren-registreren-handmatig-invoeren-iphone.png';
import featureKlanten from '../assets/uurwerk-uren-per-klant-uurtarief-iphone.png';
import featureProjecten from '../assets/uurwerk-projecten-urenoverzicht-per-project-iphone.png';
import featureFactuur from '../assets/uurwerk-factuur-maken-van-uren-iphone.png';

const title = 'Urenregistratie app voor zzp’ers | Uurwerk voor iPhone';
const description =
  'Uurwerk voor iPhone: registreer gratis uren per klant en project met een timer of handmatig. Maak conceptfacturen en bekijk je gewerkte tijd.';

const schemas = [softwareApplicationSchema(), websiteSchema(), faqSchema(faqEntries)];

const screenshots = [
  {
    src: shotTimer,
    alt: 'Uurwerk app screenshot: Vandaag-scherm met lopende urentimer, totaal gewerkte uren vandaag en laatste urenregels per klant',
  },
  {
    src: shotInvoer,
    alt: 'Uurwerk app screenshot: handmatig werkuren toevoegen met datum, klant, project, omschrijving, start- en eindtijd en pauze',
  },
  {
    src: shotUren,
    alt: 'Uurwerk app screenshot: urenoverzicht per week met totaal uren, totaal bedrag en urenregels gekoppeld aan klanten en projecten',
  },
  {
    src: shotKlanten,
    alt: 'Uurwerk app screenshot: klantenlijst met uurtarief per klant, openstaande uren en knoppen voor uren en factuur maken',
  },
  {
    src: shotFactuur,
    alt: 'Uurwerk app screenshot: factuur maken van geregistreerde uren met factuurvoorbeeld inclusief btw en totaalbedrag',
  },
  {
    src: shotPdf,
    alt: 'Uurwerk app screenshot: factuur exporteren als PDF en versturen naar je klant per e-mail',
  },
  {
    src: shotBetaal,
    alt: 'Uurwerk app screenshot: betaalopvolging met openstaand bedrag en facturen voorbij de vervaldatum',
  },
];

const features = [
  {
    icon: 'timer',
    title: 'Start en stop je urentimer',
    text: 'Begin met werken en start de timer. Pauzeer tussendoor en stop wanneer je klaar bent: je uren staan direct als urenregel bij de juiste klant.',
  },
  {
    icon: 'pencil-line',
    title: 'Voeg uren ook handmatig toe',
    text: 'Timer vergeten? Voer datum, start- en eindtijd en pauze achteraf in. Uurwerk berekent het totaal en het bedrag automatisch.',
  },
  {
    icon: 'folder-kanban',
    title: 'Uren per klant en project',
    text: 'Koppel elke urenregel aan een klant en project, met eigen uurtarief en btw.',
  },
  {
    icon: 'chart-column',
    title: 'Duidelijke urenoverzichten',
    text: 'Bekijk totaal uren en bedrag per week, maand of eigen periode.',
  },
  {
    icon: 'target',
    title: 'Dagdoelen en voortgang',
    text: 'Stel een dagdoel in en zie direct hoeveel uren je vandaag al hebt gemaakt.',
  },
  {
    icon: 'receipt-text',
    title: 'Van uren naar factuur',
    text: 'Zet openstaande uren om in een conceptfactuur met btw, exporteer als PDF en zie welke facturen nog openstaan of verlopen zijn.',
  },
  {
    icon: 'smartphone',
    title: 'Gemaakt voor iPhone',
    text: 'Volledig Nederlandstalig, licht en snel. Je registreert uren onderweg, op kantoor of op de bouwplaats, precies op het moment zelf.',
  },
] as const;
---

<Base title={title} description={description} schemas={schemas}>
  <!-- Hero -->
  <section class="hero" data-placement="home-hero">
    <div class="container hero-copy">
      <Image src={appIcon} alt="" width={104} height={104} class="hero-icon" loading="eager" />
      <p class="hero-eyebrow">Urenregistratie app voor iPhone</p>
      <h1>Uren bijhouden zonder gedoe, <span class="h1-line">gemaakt voor zzp&rsquo;ers</span></h1>
      <p class="hero-sub">
        Uurwerk is een eenvoudige urenregistratie app voor zzp&rsquo;ers, freelancers en kleine
        ondernemers. Start een timer of voer uren handmatig in, houd uren bij per klant en
        project en maak er met een paar tikken een factuur van.
      </p>
      <div class="hero-actions">
        <AppStoreButton size="lg" />
        <a class="btn btn-secondary hero-more" href="#functies">Bekijk de functies <Icon name="arrow-down" size={17} /></a>
      </div>
      <p class="hero-note">
        Gratis uren en conceptfacturen &middot; Pro voor facturen versturen
      </p>
    </div>
    <div class="hero-phones">
      <div class="hero-phones-inner">
        <span class="hero-glow" aria-hidden="true"></span>
        <div class="iphone hero-phone phone-left">
          <Image
            src={heroOverzicht}
            alt="Urenoverzicht per maand in de Uurwerk urenregistratie app, met totaal uren en totaal bedrag"
            width={270}
            widths={[200, 270, 540]}
            sizes="(max-width: 767px) 196px, 270px"
            loading="lazy"
          />
        </div>
        <div class="iphone hero-phone phone-right" aria-hidden="true">
          <Image src={featureKlanten} alt="" width={270} widths={[270, 540]} sizes="270px" loading="lazy" />
        </div>
        <div class="iphone hero-phone phone-front">
          <Image
            src={heroVandaag}
            alt="Uurwerk urenregistratie app op iPhone: Vandaag-scherm met dagdoel, urentimer en laatste urenregels"
            width={300}
            widths={[214, 300, 600]}
            sizes="(max-width: 767px) 214px, 300px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Functies -->
  <section class="functies" id="functies">
    <div class="container functies-grid" data-reveal>
      <div class="functies-head">
        <span class="eyebrow">Functies</span>
        <h2 class="section-title">Alles voor je urenregistratie, niets wat je niet nodig hebt</h2>
        <p class="section-lead">
          Geen zware boekhoudsoftware, maar precies de functies die je als zelfstandige dagelijks
          gebruikt.
        </p>
      </div>
      <ul class="feature-list">
        {features.map((feature) => (
          <li>
            <span class="icon-chip"><Icon name={feature.icon} size={21} /></span>
            <div>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Hoe het werkt -->
  <section class="how" id="hoe-het-werkt">
    <div class="container" data-reveal>
      <div class="section-head">
        <span class="eyebrow">Hoe het werkt</span>
        <h2 class="section-title">In drie stappen grip op je uren</h2>
      </div>
      <ol class="steps">
        <li>
          <span class="step-number">1</span>
          <div>
            <h3>Voeg klanten en projecten toe</h3>
            <p>
              Zet je klanten in de app met uurtarief, btw-tarief en contactgegevens. Maak per klant
              een of meer projecten aan.
            </p>
          </div>
        </li>
        <li>
          <span class="step-number">2</span>
          <div>
            <h3>Registreer je uren</h3>
            <p>
              Start de timer terwijl je werkt of voer uren achteraf handmatig in, met een korte
              omschrijving van wat je hebt gedaan.
            </p>
          </div>
        </li>
        <li>
          <span class="step-number">3</span>
          <div>
            <h3>Bekijk overzichten en factureer</h3>
            <p>
              Zie per week of maand hoeveel uren en omzet je hebt gedraaid en zet openstaande uren om
              in een factuur.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Screenshots -->
  <section class="screenshots" id="screenshots">
    <div class="container" data-reveal>
      <div class="section-head center">
        <span class="eyebrow">Screenshots</span>
        <h2 class="section-title">Zo ziet Uurwerk eruit</h2>
        <p class="section-lead">Echte schermen uit de app, zoals je ze ook in de App Store vindt.</p>
      </div>
    </div>
    <ul class="shot-strip" id="shot-strip" tabindex="0" aria-label="App-screenshots, horizontaal scrollbaar">
      {screenshots.map((shot) => (
        <li>
          <Image
            src={shot.src}
            alt={shot.alt}
            width={252}
            widths={[218, 252, 504]}
            sizes="(max-width: 767px) 218px, 252px"
            loading="lazy"
            class="shot"
          />
        </li>
      ))}
    </ul>
    <div class="container strip-controls">
      <div class="strip-dots" aria-hidden="true">
        {screenshots.map((_, index) => <span class:list={{ 'is-active': index === 0 }}></span>)}
      </div>
      <div class="strip-arrows">
        <button type="button" class="strip-arrow" data-dir="-1" aria-label="Vorige screenshot" aria-controls="shot-strip"><Icon name="chevron-left" size={20} /></button>
        <button type="button" class="strip-arrow" data-dir="1" aria-label="Volgende screenshot" aria-controls="shot-strip"><Icon name="chevron-right" size={20} /></button>
      </div>
    </div>
  </section>

  <!-- Timer en handmatig -->
  <section class="feature-row row-first">
    <div class="container split" data-reveal>
      <div class="split-copy">
        <span class="eyebrow">Timer en handmatige invoer</span>
        <h2>Uren registreren zoals het jou uitkomt</h2>
        <p>
          Werk je geconcentreerd aan een klus? Start de timer en Uurwerk houdt de tijd bij,
          inclusief pauzes. Achteraf invullen kan net zo makkelijk: kies datum, start- en eindtijd
          en pauze, en het totaal wordt automatisch berekend.
        </p>
        <ul class="check-list">
          <li>Timer met pauze- en stopknop</li>
          <li>Handmatige invoer met start, einde en pauze</li>
          <li>Omschrijving per urenregel, zodat je later weet wat je deed</li>
          <li>Totaal vandaag en dagdoel in &eacute;&eacute;n oogopslag</li>
        </ul>
      </div>
      <div class="split-visual visual-sage">
        <div class="iphone">
          <Image
            src={featureInvoer}
            alt="Handmatig uren registreren in Uurwerk met datum, klant, project, omschrijving, start- en eindtijd en pauze"
            width={300}
            widths={[230, 300, 600]}
            sizes="(max-width: 767px) 230px, 300px"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Klanten en projecten -->
  <section class="feature-row">
    <div class="container split reverse" data-reveal>
      <div class="split-copy">
        <span class="eyebrow">Klanten en projecten</span>
        <h2>Elk uur op de juiste plek</h2>
        <p>
          Leg per klant het uurtarief, btw-tarief en de contactgegevens vast. Koppel uren aan
          projecten, zodat je precies ziet hoeveel tijd een opdracht kost en wat er nog open staat
          om te factureren.
        </p>
        <ul class="check-list">
          <li>Eigen uurtarief en btw per klant of project</li>
          <li>Open uren en openstaand bedrag per klant</li>
          <li>Vanuit de klantenlijst direct uren bekijken of een factuur maken</li>
        </ul>
      </div>
      <div class="split-visual visual-sand">
        <div class="iphone">
          <Image
            src={featureKlanten}
            alt="Klantenlijst in Uurwerk met uurtarief per klant, open uren en knoppen voor uren en factuur maken"
            width={300}
            widths={[230, 300, 600]}
            sizes="(max-width: 767px) 230px, 300px"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Rapportages -->
  <section class="feature-row">
    <div class="container split" data-reveal>
      <div class="split-copy">
        <span class="eyebrow">Overzichten</span>
        <h2>Weten waar je tijd naartoe gaat</h2>
        <p>
          Filter je uren per week, maand of eigen periode en zie direct het totaal aantal uren en
          het bijbehorende bedrag. Handig voor je facturatie, je administratie en voor het
          bijhouden van het urencriterium.
        </p>
        <ul class="check-list">
          <li>Totaal uren en totaal bedrag per periode</li>
          <li>Urenregels per dag, met klant, project en omschrijving</li>
          <li>Betaalopvolging: zie welke facturen openstaan of verlopen zijn</li>
        </ul>
      </div>
      <div class="split-visual visual-sage">
        <div class="iphone">
          <Image
            src={featureProjecten}
            alt="Projectenoverzicht in Uurwerk met per project het aantal uren en het bijbehorende bedrag"
            width={300}
            widths={[230, 300, 600]}
            sizes="(max-width: 767px) 230px, 300px"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Facturatie -->
  <section class="feature-row row-last">
    <div class="container split reverse" data-reveal>
      <div class="split-copy">
        <span class="eyebrow">Facturatie</span>
        <h2>Van geregistreerde uren naar een nette factuur</h2>
        <p>
          Kies de openstaande uren van een klant, controleer het factuurvoorbeeld met btw en
          totaalbedrag en exporteer de factuur als PDF. Verzonden en betaalde facturen vind je
          altijd terug.
        </p>
        <ul class="check-list">
          <li>Conceptfacturen maken is gratis</li>
          <li>Factuur als PDF, klaar om te delen</li>
          <li>Versturen vanuit de app met Uurwerk Pro</li>
        </ul>
      </div>
      <div class="split-visual visual-sand">
        <div class="iphone">
          <Image
            src={featureFactuur}
            alt="Factuur controleren in Uurwerk met factuurvoorbeeld inclusief urenregels, btw en totaalbedrag"
            width={300}
            widths={[230, 300, 600]}
            sizes="(max-width: 767px) 230px, 300px"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Over Uurwerk -->
  <section class="about">
    <div class="container reading" data-reveal>
      <ProductIdentity variant="plain" />
      <p class="guide-pointer"><Icon name="book-open" size={20} /><span>Nieuw met uren vastleggen? Begin bij de <a href="/urenregistratie/">complete gids over urenregistratie</a> en kies een aanpak voor jouw werk.</span></p>
    </div>
  </section>

  <!-- Gratis en Pro -->
  <section class="prices" aria-label="Gratis en Pro">
    <div class="container prices-column" data-reveal>
      <span class="eyebrow">Gratis &amp; Pro</span>
      <PricingTable variant="home" />
    </div>
  </section>

  <!-- Tools -->
  <section class="tools" aria-labelledby="tools-heading">
    <div class="container" data-reveal>
      <div class="tools-card" data-placement="home-tools">
        <div class="tools-copy">
          <Icon name="file-spreadsheet" size={30} class="tools-icon" />
          <h2 id="tools-heading">Begin met een urenstaat of rekenvoorbeeld</h2>
          <p>Download een gratis Excel- of PDF-sjabloon, bereken je resterende uren of bekijk hoe je van gewerkte uren een factuur maakt.</p>
          <p class="tools-note">Uurwerk voor iPhone is gemaakt door <a href="/over-uurwerk/">Patrick van der Ploeg</a>. <a href="/contact/">Een vraag over de app?</a></p>
        </div>
        <div class="tools-actions">
          <a class="btn btn-primary" href="/urenstaat-maken/">Gratis urenstaatsjabloon</a>
          <a class="btn btn-secondary" href="/urencriterium/#rekenhulp">Urencriterium berekenen</a>
          <a class="btn btn-secondary" href="/uren-factureren/">Van uren naar factuur</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Gidsen -->
  <section class="guides" id="gidsen">
    <div class="container" data-reveal>
      <div class="section-head">
        <span class="eyebrow">Gidsen</span>
        <h2 class="section-title">Alles over urenregistratie in Nederland</h2>
        <p class="section-lead">
          Praktische, feitelijke uitleg over uren bijhouden als zelfstandige: van het urencriterium
          tot het maken van een urenstaat.
        </p>
      </div>
      <div class="guides-grid">
        {GUIDES.map((guide) => (
          <a class="guide-card" href={guideUrl(guide.slug)}>
            <div class="guide-text">
              <h3>{guide.navTitle}</h3>
              <p>{guide.hook}</p>
            </div>
            <span class="guide-more">Lees de gids <span aria-hidden="true">&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="container faq-grid" data-reveal>
      <div class="faq-head">
        <span class="eyebrow">FAQ</span>
        <h2 class="section-title">Veelgestelde vragen</h2>
      </div>
      <Faq entries={faqEntries} />
    </div>
  </section>

  <CtaBanner />
</Base>

<script>
  // Pijlknoppen verschuiven de screenshotstrip één kaart; de stippen volgen de scrollpositie.
  const strip = document.querySelector<HTMLElement>('#shot-strip');
  const dots = document.querySelectorAll<HTMLElement>('.strip-dots span');
  if (strip) {
    const step = () => {
      const first = strip.querySelector('li');
      return first ? first.getBoundingClientRect().width + parseFloat(getComputedStyle(strip).columnGap || '20') : 272;
    };
    const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    document.querySelectorAll<HTMLButtonElement>('.strip-arrow').forEach((button) => {
      button.addEventListener('click', () => {
        strip.scrollBy({ left: Number(button.dataset.dir) * step(), behavior: smooth as ScrollBehavior });
      });
    });
    const update = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      const index = max <= 0 ? 0 : Math.round((strip.scrollLeft / max) * (dots.length - 1));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };
    strip.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  /* Hero */
  .hero {
    padding-top: 80px;
    overflow: hidden;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  :global(.hero-icon) {
    width: 104px;
    height: 104px;
    border-radius: 24px;
    border: 1px solid rgba(30, 41, 33, 0.08);
    box-shadow: 0 10px 24px -8px rgba(67, 96, 79, 0.25);
  }

  .hero-eyebrow {
    margin: 32px 0 20px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--sage-faint);
    border: 1px solid var(--sage-soft);
    color: var(--sage-deep);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .hero h1 {
    max-width: 960px;
    margin: 0 0 20px;
    font-size: clamp(2.375rem, 6vw, 4rem);
    line-height: 1.03;
    letter-spacing: -0.0375em;
  }

  @media (min-width: 768px) {
    .h1-line {
      display: inline-block;
    }
  }

  .hero-sub {
    max-width: 620px;
    margin: 0;
    text-wrap: pretty;
    color: var(--ink-2);
    font-size: clamp(1.0625rem, 1.8vw, 1.1875rem);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 36px;
  }

  .hero-more {
    min-height: 56px;
    font-size: 1rem;
  }

  .hero-note {
    margin: 18px 0 0;
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .hero-phones {
    position: relative;
    height: 600px;
    overflow: hidden;
  }

  .hero-phones-inner {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1120px;
    height: 600px;
    transform: translateX(-50%);
    transform-origin: top center;
  }

  .hero-glow {
    position: absolute;
    left: 160px;
    top: 110px;
    width: 800px;
    height: 800px;
    border-radius: 50%;
    background: radial-gradient(closest-side, #dce7e0, rgba(250, 248, 243, 0));
  }

  .hero-phone {
    position: absolute;
  }

  .phone-left {
    left: 180px;
    top: 170px;
    width: 270px;
  }

  .phone-right {
    left: 670px;
    top: 170px;
    width: 270px;
  }

  .phone-front {
    left: 410px;
    top: 80px;
    width: 300px;
    z-index: 2;
  }

  /* Functies */
  .functies {
    padding: 140px 0 120px;
  }

  .functies-grid {
    display: grid;
    grid-template-columns: 420px minmax(0, 1fr);
    gap: 120px;
    align-items: start;
  }

  .functies-head .section-lead {
    margin-top: 16px;
  }

  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .feature-list li {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }

  .feature-list h3 {
    margin: 9px 0 6px;
    font-size: 1.125rem;
    line-height: 1.35;
    letter-spacing: -0.017em;
  }

  .feature-list p {
    margin: 0;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Hoe het werkt */
