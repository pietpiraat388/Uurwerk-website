---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import PricingTable from '../components/PricingTable.astro';
import ProductIdentity from '../components/ProductIdentity.astro';
import { faqSchema, softwareApplicationSchema, websiteSchema } from '../lib/schema';
import { GUIDES, guideUrl } from '../lib/site';
import { HOME_FAQ as faqEntries } from '../lib/product-faq';

import ipadVandaag from '../assets/v2/ipad-liggend-vandaag.png';
import ipadUren from '../assets/v2/ipad-liggend-uren.png';
import ipadKlanten from '../assets/v2/ipad-liggend-klanten.png';
import ipadProjecten from '../assets/v2/ipad-liggend-projecten.png';
import ipadUrenbriefje from '../assets/v2/ipad-liggend-urenbriefje.png';
import ipadKlantTekent from '../assets/v2/ipad-liggend-klant-tekent.png';
import ipadHerinneringen from '../assets/v2/ipad-liggend-herinneringen.png';
import ipadLockscreen from '../assets/v2/ipad-lockscreen-timer.png';
import ipadFactuur from '../assets/v2/ipad-factuur.png';
import iphoneVandaag from '../assets/v2/iphone-vandaag.png';
import iphoneLockscreen from '../assets/v2/iphone-lockscreen-timer.png';
import iphoneUren from '../assets/v2/iphone-declarabel.png';
import iphoneFactuur from '../assets/v2/iphone-factuur.png';
import iphoneUrenbriefje from '../assets/v2/iphone-urenbriefje-tekenen.png';
import iphoneHerinneringen from '../assets/v2/iphone-herinneringen.png';
import iphoneProjecten from '../assets/v2/iphone-projecten.png';
import kaartDeclarabel from '../assets/v2/kaart-declarabel.png';
import kaartGetekend from '../assets/v2/kaart-urenbriefje-getekend.png';
import kaartPdf from '../assets/v2/kaart-factuur-pdf.png';
import uiUrenToevoegen from '../assets/v2/ui-uren-toevoegen-sheet.png';
import uiKlantenlijst from '../assets/v2/ui-klantenlijst.png';
import uiTimer from '../assets/v2/ui-timer.png';
import uiTotaalVandaag from '../assets/v2/ui-totaal-vandaag.png';
import uiWeek from '../assets/v2/ui-week.png';

const title = 'Urenregistratie app voor zzp’ers | Uurwerk voor iPhone';
const description =
  'Uurwerk is een urenregistratie app voor iPhone. Houd gratis uren bij per klant en project, met timer of handmatig, en maak er conceptfacturen van.';

const schemas = [softwareApplicationSchema(), websiteSchema(), faqSchema(faqEntries)];

const features = [
  {
    icon: 'timer',
    title: 'Start en stop je urentimer',
    text: 'Begin met werken en start de timer. Pauzeer tussendoor en stop wanneer je klaar bent: je uren staan direct als urenregel bij de juiste klant.',
  },
  {
    icon: 'pencil-line',
    title: 'Voeg uren ook handmatig toe',
    text: 'Timer vergeten? Voer datum, start- en eindtijd en pauze achteraf in. Uurwerk berekent het totaal en het bedrag automatisch.',
  },
  {
    icon: 'folder-kanban',
    title: 'Uren per klant en project',
    text: 'Koppel elke urenregel aan een klant en project, met eigen uurtarief en btw.',
  },
  {
    icon: 'chart-column',
    title: 'Duidelijke urenoverzichten',
    text: 'Bekijk totaal uren en bedrag per week, maand of eigen periode.',
  },
  {
    icon: 'target',
    title: 'Dagdoelen en voortgang',
    text: 'Stel een dagdoel in en zie direct hoeveel uren je vandaag al hebt gemaakt.',
  },
  {
    icon: 'receipt-text',
    title: 'Van uren naar factuur',
    text: 'Zet openstaande uren om in een conceptfactuur met btw, exporteer als PDF en zie welke facturen nog openstaan of verlopen zijn.',
  },
  {
    icon: 'smartphone',
    title: 'Gemaakt voor iPhone',
    text: 'Volledig Nederlandstalig, licht en snel. Je registreert uren onderweg, op kantoor of op de bouwplaats, precies op het moment zelf.',
  },
] as const;

const [fTimer, fHandmatig, fKlant, fOverzicht, fDagdoel, fFactuur, fIphone] = features;

const ipadScreens = [
  { icon: 'sun', title: 'Vandaag', text: 'Je dag, lopende timer en weekoverzicht naast elkaar.', src: ipadVandaag, alt: 'Uurwerk op iPad: Vandaag-scherm met totaal uren, lopende timer, declarabele uren en weekoverzicht' },
  { icon: 'timer', title: 'Uren', text: 'Lijst en details tegelijk, dankzij het grote scherm.', src: ipadUren, alt: 'Uurwerk op iPad: urenlijst met details van een urenregel ernaast' },
  { icon: 'users', title: 'Klanten', text: 'Uurtarief, openstaande uren en facturen per klant.', src: ipadKlanten, alt: 'Uurwerk op iPad: klantenlijst met uurtarief, open uren en projecten per klant' },
  { icon: 'folder-kanban', title: 'Projecten', text: 'Budget en voortgang per project.', src: ipadProjecten, alt: 'Uurwerk op iPad: projectenoverzicht met uren, bedrag en budget per project' },
  { icon: 'signature', title: 'Urenbriefje', text: 'Overzicht met handtekening, klaar om te delen.', src: ipadUrenbriefje, alt: 'Uurwerk op iPad: getekend urenbriefje met urenoverzicht en handtekening van de klant' },
  { icon: 'pen-line', title: 'Klant tekent', text: 'Geef je iPad aan je klant om te tekenen.', src: ipadKlantTekent, alt: 'Uurwerk op iPad: klant tekent het urenbriefje direct op het scherm' },
  { icon: 'bell', title: 'Herinneringen', text: 'Slimme seintjes voor timer, week en factuur.', src: ipadHerinneringen, alt: 'Uurwerk op iPad: instellingen voor slimme herinneringen' },
] as const;

const iphoneScreens = [
  { title: 'Vandaag', text: 'Je dag, timer en dagdoel in één blik.', src: iphoneVandaag, alt: 'Uurwerk op iPhone: Vandaag-scherm met totaal uren, dagdoel en lopende timer' },
  { title: 'Timer op lockscreen', text: 'Pauzeer of stop zonder de app te openen.', src: iphoneLockscreen, alt: 'Uurwerk op iPhone: lopende urentimer als Live Activity op het toegangsscherm' },
  { title: 'Uren & declarabel', text: 'Filter direct op wat je kunt factureren.', src: iphoneUren, alt: 'Uurwerk op iPhone: urenoverzicht met filter op declarabele uren' },
  { title: 'Factuur', text: 'Van uren naar PDF in seconden.', src: iphoneFactuur, alt: 'Uurwerk op iPhone: factuurvoorbeeld met urenregels, btw en totaalbedrag' },
  { title: 'Urenbriefje', text: 'Je klant tekent direct op je scherm.', src: iphoneUrenbriefje, alt: 'Uurwerk op iPhone: urenbriefje laten ondertekenen door de klant' },
  { title: 'Herinneringen', text: 'Nooit meer uren vergeten.', src: iphoneHerinneringen, alt: 'Uurwerk op iPhone: slimme herinneringen om uren te registreren' },
] as const;
---

<Base title={title} description={description} schemas={schemas} headerOverlay>
  <!-- Hero -->
  <section class="hero" data-placement="home-hero">
    <div class="hero-deco" aria-hidden="true">
      <span class="ring ring-1"></span>
      <span class="ring ring-2"></span>
    </div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>
          <span class="hero-eyebrow">Urenregistratie app voor iPhone</span>
          <span class="hero-title">Uren bijhouden zonder gedoe, <span class="h1-accent">gemaakt voor zzp&rsquo;ers</span></span>
        </h1>
        <p class="hero-sub">
          Uurwerk is een eenvoudige urenregistratie app voor zzp&rsquo;ers, freelancers en kleine
          ondernemers. Start een timer of voer uren handmatig in, houd uren bij per klant en
          project en maak er met een paar tikken een factuur van.
        </p>
        <div class="hero-actions">
          <AppStoreButton size="lg" tone="light" />
          <a class="btn hero-more" href="#functies">Bekijk de functies <Icon name="arrow-down" size={17} /></a>
        </div>
        <p class="hero-note">
          Gratis uren en conceptfacturen &middot; Pro voor facturen versturen
        </p>
      </div>
      <div class="hero-visual">
        <span class="hero-glow" aria-hidden="true"></span>
        <div class="ipad-frame hero-ipad">
          <Image
            src={ipadVandaag}
            alt="Uurwerk urenregistratie app op iPad: Vandaag-scherm met totaal uren, lopende timer, declarabele uren en laatste urenregels"
            width={640}
            widths={[360, 640, 1280]}
            sizes="(max-width: 767px) 92vw, 640px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <Image
          src={iphoneFactuur}
          alt="Uurwerk op iPhone: factuur maken van geregistreerde uren met btw en totaalbedrag"
          width={196}
          widths={[120, 196, 392]}
          sizes="(max-width: 767px) 30vw, 196px"
          loading="eager"
          class="device hero-iphone"
        />
        <Image src={kaartDeclarabel} alt="" width={200} widths={[140, 200, 400]} sizes="(max-width: 767px) 40vw, 200px" loading="eager" class="float hero-float-billable" />
        <Image src={kaartGetekend} alt="" width={260} widths={[200, 260, 520]} sizes="(max-width: 767px) 56vw, 260px" loading="eager" class="float hero-float-signed" />
      </div>
    </div>
  </section>

  <!-- Functies -->
  <section class="functies" id="functies">
    <div class="container" data-reveal>
      <div class="functies-head">
        <div>
          <span class="eyebrow">Functies</span>
          <h2 class="section-title">Alles voor je urenregistratie, niets wat je niet nodig hebt</h2>
        </div>
        <p class="section-lead">
          Geen zware boekhoudsoftware, maar precies de functies die je als zelfstandige dagelijks
          gebruikt.
        </p>
      </div>
      <div class="bento">
        <article class="tile tile-dark tile-wide tile-split">
          <div class="tile-copy">
            <span class="tile-icon"><Icon name={fTimer.icon} size={22} /></span>
            <h3>{fTimer.title}</h3>
            <p>{fTimer.text}</p>
          </div>
          <div class="tile-media">
            <Image src={iphoneLockscreen} alt="Lopende urentimer van Uurwerk op het toegangsscherm van de iPhone" width={196} widths={[170, 196, 392]} sizes="196px" loading="lazy" class="device tile-phone" />
          </div>
        </article>
        <article class="tile tile-narrow">
          <div class="tile-copy">
            <span class="tile-icon"><Icon name={fHandmatig.icon} size={22} /></span>
            <h3>{fHandmatig.title}</h3>
            <p>{fHandmatig.text}</p>
          </div>
          <div class="tile-panel">
            <Image src={uiUrenToevoegen} alt="Uren handmatig toevoegen in Uurwerk met klant, project, datum, start- en eindtijd" width={200} widths={[200, 400]} sizes="200px" loading="lazy" class="ui-card ui-sheet" />
          </div>
        </article>
        {[fKlant, fOverzicht, fDagdoel].map((feature, index) => (
          <article class:list={['tile tile-third', { 'tile-mint': index === 1 }]}>
            <div class="tile-copy">
              <span class="tile-icon"><Icon name={feature.icon} size={22} /></span>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
          </article>
        ))}
        <article class="tile tile-half tile-split">
          <div class="tile-copy">
            <span class="tile-icon"><Icon name={fFactuur.icon} size={22} /></span>
            <h3>{fFactuur.title}</h3>
            <p>{fFactuur.text}</p>
          </div>
          <div class="tile-media">
            <Image src={iphoneFactuur} alt="Conceptfactuur in Uurwerk met urenregels, btw en totaalbedrag" width={160} widths={[150, 160, 320]} sizes="160px" loading="lazy" class="device tile-phone tile-phone-sm" />
            <Image src={kaartPdf} alt="" width={240} widths={[240, 480]} sizes="240px" loading="lazy" class="float tile-float-pdf" />
          </div>
        </article>
        <article class="tile tile-dark tile-half tile-split">
          <div class="tile-copy">
            <span class="tile-icon"><Icon name={fIphone.icon} size={22} /></span>
            <h3>{fIphone.title}</h3>
            <p>{fIphone.text}</p>
          </div>
          <div class="tile-media">
            <Image src={iphoneVandaag} alt="Vandaag-scherm van Uurwerk op iPhone met dagdoel en timer" width={160} widths={[150, 160, 320]} sizes="160px" loading="lazy" class="device tile-phone tile-phone-sm" />
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Hoe het werkt -->
  <section class="how" id="hoe-het-werkt">
    <div class="container" data-reveal>
      <div class="section-head">
        <span class="eyebrow">Hoe het werkt</span>
        <h2 class="section-title">In drie stappen grip op je uren</h2>
      </div>
      <ol class="steps">
        <li>
          <span class="step-number">1</span>
          <h3>Voeg klanten en projecten toe</h3>
          <p>
            Zet je klanten in de app met uurtarief, btw-tarief en contactgegevens. Maak per klant
            een of meer projecten aan.
          </p>
          <div class="step-panel">
            <Image src={uiKlantenlijst} alt="Klantenlijst in Uurwerk met uurtarief en open uren per klant" width={210} widths={[210, 420]} sizes="210px" loading="lazy" class="ui-card step-klanten" />
          </div>
        </li>
        <li>
          <span class="step-number">2</span>
          <h3>Registreer je uren</h3>
          <p>
            Start de timer terwijl je werkt of voer uren achteraf handmatig in, met een korte
            omschrijving van wat je hebt gedaan.
          </p>
          <div class="step-panel">
            <Image src={uiTimer} alt="Lopende timer in Uurwerk met pauze- en stopknop" width={280} widths={[280, 560]} sizes="280px" loading="lazy" class="ui-card step-timer" />
          </div>
        </li>
        <li>
          <span class="step-number">3</span>
          <h3>Bekijk overzichten en factureer</h3>
          <p>
            Zie per week of maand hoeveel uren en omzet je hebt gedraaid en zet openstaande uren om
            in een factuur.
          </p>
          <div class="step-panel step-panel-stack">
            <Image src={uiTotaalVandaag} alt="Totaal uren en bedrag vandaag in Uurwerk" width={270} widths={[270, 540]} sizes="270px" loading="lazy" class="ui-card step-totaal" />
            <Image src={uiWeek} alt="Weekoverzicht van gewerkte uren in Uurwerk" width={216} widths={[216, 432]} sizes="216px" loading="lazy" class="ui-card step-week" />
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Screenshots: iPhone en iPad -->
  <section class="screens" id="screenshots">
    <div class="container" data-reveal>
      <div class="section-head center">
        <span class="eyebrow eyebrow-icon"><Icon name="tablet-smartphone" size={16} />Screenshots</span>
        <h2 class="section-title">Zo ziet Uurwerk eruit</h2>
        <p class="section-lead">Echte schermen uit de app, zoals je ze ook in de App Store vindt.</p>
      </div>

      <div class="ipad-showcase" data-ipad-showcase>
        <div class="ipad-tabs">
          <p class="device-label"><Icon name="tablet" size={18} />Op je iPad</p>
          <div class="ipad-tablist" role="tablist" aria-label="iPad-schermen">
            {ipadScreens.map((screen, index) => (
              <button
                type="button"
                role="tab"
                class="ipad-tab"
                id={`ipad-tab-${index}`}
                aria-controls="ipad-panel"
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                data-index={index}
              >
                <span class="ipad-tab-icon"><Icon name={screen.icon} size={18} /></span>
                <span class="ipad-tab-text">
                  <span class="ipad-tab-title">{screen.title}</span>
                  <span class="ipad-tab-desc">{screen.text}</span>
                  <span class="ipad-tab-progress" aria-hidden="true"></span>
                </span>
              </button>
            ))}
          </div>
        </div>
        <div class="ipad-frame ipad-stage" id="ipad-panel" role="tabpanel" aria-labelledby="ipad-tab-0">
          {ipadScreens.map((screen, index) => (
            <Image
              src={screen.src}
              alt={screen.alt}
              width={800}
              widths={[360, 800, 1600]}
              sizes="(max-width: 767px) 92vw, (max-width: 1099px) 90vw, 800px"
              loading="lazy"
              class:list={['ipad-screen', { 'is-active': index === 0 }]}
              data-index={index}
            />
          ))}
        </div>
      </div>

      <div class="iphone-showcase">
        <p class="device-label"><Icon name="smartphone" size={18} />Op je iPhone</p>
        <ul class="phone-row" tabindex="0" aria-label="iPhone-schermen, horizontaal scrollbaar">
          {iphoneScreens.map((screen) => (
            <li>
              <figure>
                <Image src={screen.src} alt={screen.alt} width={184} widths={[170, 184, 368]} sizes="184px" loading="lazy" class="device phone-shot" />
                <figcaption>
                  <strong>{screen.title}</strong>
                  <span>{screen.text}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>

      <p class="sync-note">
        <span class="sync-icon"><Icon name="refresh-cw" size={16} /></span>
        Begin op je iPhone, ga verder op je iPad. Je uren staan overal klaar.
      </p>
    </div>
  </section>

  <!-- Timer en handmatig -->
  <section class="feature-row row-first">
    <div class="container split" data-reveal>
      <div class="split-copy">
        <span class="eyebrow">Timer en handmatige invoer</span>
        <h2>Uren registreren zoals het jou uitkomt</h2>
        <p>
          Werk je geconcentreerd aan een klus? Start de timer en Uurwerk houdt de tijd bij,
          inclusief pauzes. Achteraf invullen kan net zo makkelijk: kies datum, start- en eindtijd
          en pauze, en het totaal wordt automatisch berekend.
        </p>
        <ul class="check-list">
          <li>Timer met pauze- en stopknop</li>
          <li>Handmatige invoer met start, einde en pauze</li>
          <li>Omschrijving per urenregel, zodat je later weet wat je deed</li>
          <li>Totaal vandaag en dagdoel in &eacute;&eacute;n oogopslag</li>
        </ul>
      </div>
      <div class="split-visual visual-dark">
        <Image src={ipadLockscreen} alt="Lopende urentimer van Uurwerk op het toegangsscherm van de iPad" width={330} widths={[230, 330, 660]} sizes="(max-width: 767px) 60vw, 330px" loading="lazy" class="device v1-ipad" />
        <Image src={iphoneVandaag} alt="Vandaag-scherm van Uurwerk op iPhone met totaal uren en lopende timer" width={190} widths={[130, 190, 380]} sizes="(max-width: 767px) 35vw, 190px" loading="lazy" class="device v1-iphone" />
      </div>
    </div>
  </section>

  <!-- Klanten en projecten -->
  <section class="feature-row">
    <div class="container split reverse" data-reveal>
      <div class="split-copy">
        <span class="eyebrow">Klanten en projecten</span>
        <h2>Elk uur op de juiste plek</h2>
        <p>
          Leg per klant het uurtarief, btw-tarief en de contactgegevens vast. Koppel uren aan
          projecten, zodat je precies ziet hoeveel tijd een opdracht kost en wat er nog open staat
          om te factureren.
        </p>
        <ul class="check-list">
          <li>Eigen uurtarief en btw per klant of project</li>
          <li>Open uren en openstaand bedrag per klant</li>
          <li>Vanuit de klantenlijst direct uren bekijken of een factuur maken</li>
        </ul>
      </div>
      <div class="split-visual visual-sand">
        <div class="ipad-frame v2-ipad">
          <Image src={ipadKlanten} alt="Klantenlijst in Uurwerk op iPad met uurtarief, open uren en projecten per klant" width={480} widths={[300, 480, 960]} sizes="(max-width: 767px) 80vw, 480px" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Rapportages -->
  <section class="feature-row">
    <div class="container split" data-reveal>
      <div class="split-copy">
        <span class="eyebrow">Overzichten</span>
        <h2>Weten waar je tijd naartoe gaat</h2>
        <p>
          Filter je uren per week, maand of eigen periode en zie direct het totaal aantal uren en
          het bijbehorende bedrag. Handig voor je facturatie, je administratie en voor het
          bijhouden van het urencriterium.
        </p>
        <ul class="check-list">
          <li>Totaal uren en totaal bedrag per periode</li>
          <li>Urenregels per dag, met klant, project en omschrijving</li>
          <li>Betaalopvolging: zie welke facturen openstaan of verlopen zijn</li>
        </ul>
      </div>
      <div class="split-visual visual-mint">
        <Image src={iphoneUren} alt="Urenoverzicht per maand in Uurwerk met totaal uren en totaal bedrag" width={206} widths={[150, 206, 412]} sizes="(max-width: 767px) 40vw, 206px" loading="lazy" class="device v3-iphone-a" />
        <Image src={iphoneProjecten} alt="Projectenoverzicht in Uurwerk met per project het aantal uren en het bijbehorende bedrag" width={206} widths={[150, 206, 412]} sizes="(max-width: 767px) 40vw, 206px" loading="lazy" class="device v3-iphone-b" />
        <Image src={kaartDeclarabel} alt="" width={206} widths={[150, 206, 412]} sizes="(max-width: 767px) 40vw, 206px" loading="lazy" class="float v3-card" />
      </div>
    </div>
  </section>

  <!-- Facturatie -->
  <section class="feature-row row-last">
    <div class="container split reverse" data-reveal>
      <div class="split-copy">
        <span class="eyebrow">Facturatie</span>
        <h2>Van geregistreerde uren naar een nette factuur</h2>
        <p>
          Kies de openstaande uren van een klant, controleer het factuurvoorbeeld met btw en
          totaalbedrag en exporteer de factuur als PDF. Verzonden en betaalde facturen vind je
          altijd terug.
        </p>
        <ul class="check-list">
          <li>Conceptfacturen maken is gratis</li>
          <li>Factuur als PDF, klaar om te delen</li>
          <li>Versturen vanuit de app met Uurwerk Pro</li>
        </ul>
      </div>
      <div class="split-visual visual-dark">
        <Image src={ipadFactuur} alt="Factuur controleren in Uurwerk op iPad met factuurvoorbeeld inclusief urenregels, btw en totaalbedrag" width={340} widths={[250, 340, 680]} sizes="(max-width: 767px) 64vw, 340px" loading="lazy" class="device v4-ipad" />
        <Image src={kaartPdf} alt="" width={300} widths={[220, 300, 600]} sizes="(max-width: 767px) 56vw, 300px" loading="lazy" class="float v4-card" />
      </div>
    </div>
  </section>

  <!-- Over Uurwerk -->
  <section class="about">
    <div class="container reading" data-reveal>
      <ProductIdentity variant="plain" />
      <div class="app-fit">
        <h2>Urenregistratie app voor zzp&rsquo;ers: voor wie is Uurwerk?</h2>
        <p>
