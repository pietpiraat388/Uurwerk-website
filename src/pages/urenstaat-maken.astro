---
import Guide from '../layouts/Guide.astro';
import type { FaqEntry } from '../lib/schema';
import { Image } from 'astro:assets';
import DownloadTiles from '../components/DownloadTiles.astro';
import Icon from '../components/Icon.astro';
import hoursImage from '../assets/uurwerk-urenoverzicht-maand-iphone.png';

const faq: FaqEntry[] = [
  { question: 'Kan ik een gratis urenstaat downloaden?', answer: 'Ja. Download op deze pagina een leeg Excel-sjabloon, een ingevuld Excel-voorbeeld of een printbaar PDF-sjabloon. Je hebt geen account nodig. In Excel berekenen de formules je urenbedragen en totalen.' },
  { question: 'Hoe schrijf ik anderhalf uur op een urenstaat?', answer: 'Anderhalf uur is 1,50 uur. Deel minuten door 60: 15 minuten is 0,25 uur en 45 minuten is 0,75 uur. Trek een niet-gewerkte pauze eerst van de werktijd af.' },
  {
    question: 'Wat is een urenstaat?',
    answer:
      'Een urenstaat is een overzicht van gewerkte uren over een periode, meestal per dag gespecificeerd met omschrijving en aantal uren. Zelfstandigen gebruiken hem als bijlage of onderbouwing bij de factuur, of omdat de opdrachtgever erom vraagt.',
  },
  {
    question: 'Wat moet er op een urenstaat staan?',
    answer:
      'Minimaal: jouw naam of bedrijfsnaam, de klant, de periode, per regel de datum, omschrijving en het aantal uren, en een totaal. Vaak komen daar het project, het uurtarief en het totaalbedrag bij.',
  },
  {
    question: 'Is een urenstaat hetzelfde als een factuur?',
    answer:
      'Nee. De urenstaat specificeert de gewerkte uren; de factuur is het betaaldocument met wettelijke factuureisen zoals factuurnummer, btw-bedrag en gegevens van beide partijen. In de praktijk stuur je de urenstaat mee als specificatie bij de factuur.',
  },
  {
    question: 'Hoe maak ik snel een urenstaat voor mijn klant?',
    answer:
      'Registreer je uren doorlopend per klant en project. Een urenoverzicht per periode is dan direct je urenstaat. In Uurwerk filter je op week, maand of eigen periode en zie je alle urenregels met omschrijving, duur en bedrag bij elkaar.',
  },
];
---

<Guide
  slug="urenstaat-maken"
  metaTitle="Urenstaat maken: voorbeeld + gratis sjabloon | Uurwerk"
  description="Maak een urenstaat met een ingevuld voorbeeld en gratis Excel- en PDF-sjablonen. Zonder account. Inclusief uitleg over uren, pauzes, tarieven en totalen."
  h1="Urenstaat maken: voorbeeld en gratis sjabloon"
  dateModified="2026-09-09"
  answer="Een urenstaat is een overzicht van je gewerkte uren voor een klant over een bepaalde periode. Je vermeldt je bedrijfsnaam, de opdrachtgever en per regel de datum, werkzaamheden en duur. Onderaan staat het totaal. Hieronder vind je een ingevuld voorbeeld en gratis sjablonen."
  faq={faq}
  ctaTitle="Je urenstaat staat al klaar in Uurwerk"
  ctaText="Registreer je uren per klant en project en filter op periode: elke urenregel met datum, omschrijving, duur en bedrag staat direct bij elkaar."
>
  <section class="download-card" id="downloads" aria-labelledby="download-title" data-placement="timesheet-downloads">
    <h2 id="download-title">Download je gratis urenstaat</h2>
    <p>Kies Excel om uren en bedragen te berekenen, of PDF om je urenstaat met de hand in te vullen. Het ingevulde voorbeeld laat zien hoe je begint.</p>
    <DownloadTiles items={[
      { href: '/downloads/urenstaat-sjabloon.xlsx', download: 'urenstaat-sjabloon.xlsx', label: 'Leeg Excel-sjabloon', icon: 'file-spreadsheet', primary: true },
      { href: '/downloads/urenstaat-voorbeeld.xlsx', download: 'urenstaat-voorbeeld.xlsx', label: 'Ingevuld Excel-voorbeeld', icon: 'sheet' },
      { href: '/downloads/urenstaat-sjabloon.pdf', download: 'urenstaat-sjabloon.pdf', label: 'Printbaar PDF-sjabloon', icon: 'printer' },
    ]} />
    <p class="download-note"><Icon name="shield-check" size={15} />Gratis, zonder account of e-mailadres. De bestanden bewerk en bewaar je op je eigen apparaat.</p>
  </section>
  <h2>Voorbeeld van een urenstaat</h2>
  <p>Zo kan een eenvoudige urenstaat voor een klant eruitzien:</p>
  <div class="table-scroll sheet-table">
    <table>
      <thead>
        <tr>
          <th colspan="4" class="sheet-head">
            <span class="sheet-title">Urenstaat &middot; Studio Noord voor Acme Bouw</span><br />
            <span class="sheet-meta">Project: websiteonderhoud &middot; 17 t/m 18 juni 2026</span><br />
            <span class="sheet-meta">Uurtarief: &euro; 85,00 exclusief btw</span>
          </th>
        </tr>
        <tr>
          <th>Datum</th>
          <th>Omschrijving</th>
          <th class="num">Uren</th>
          <th class="num">Bedrag</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>17 juni</td>
          <td>Controle urenstaat en factuurregels</td>
          <td class="num">1,50</td>
          <td class="num">&euro; 127,50</td>
        </tr>
        <tr>
          <td>18 juni</td>
          <td>Homepage bijgewerkt, nieuw menu</td>
          <td class="num">2,50</td>
          <td class="num">&euro; 212,50</td>
        </tr>
        <tr>
          <td>18 juni</td>
          <td>Timerregistratie, kleine fixes</td>
          <td class="num">0,25</td>
          <td class="num">&euro; 21,25</td>
        </tr>
        <tr class="total-row">
          <th>Totaal</th>
          <th></th>
          <th class="num">4,25</th>
          <th class="num">&euro; 361,25</th>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    Vermeld bovenaan altijd je eigen (bedrijfs)naam, de klant en de periode. Werk je met
    meerdere projecten voor dezelfde klant, groepeer de regels dan per project.
  </p>

  <h2>Wanneer heb je een urenstaat nodig?</h2>
  <p>Een urenstaat (ook wel urenlijst, urenbriefje of timesheet) gebruik je in drie situaties:</p>
  <ul class="situations">
    <li>
      <span class="icon-chip"><Icon name="receipt-text" size={19} /></span>
      <span><strong>Bij je factuur.</strong> Klanten die op uurbasis betalen willen zien waar de uren
      in zijn gaan zitten. Een specificatie voorkomt discussie en versnelt betaling.</span>
    </li>
    <li>
      <span class="icon-chip"><Icon name="briefcase" size={19} /></span>
      <span><strong>Op verzoek van de opdrachtgever.</strong> Bij detachering of inhuur via een bureau
      is een goedgekeurde urenstaat vaak de basis voor uitbetaling.</span>
    </li>
    <li>
      <span class="icon-chip"><Icon name="folder-check" size={19} /></span>
      <span><strong>Voor je eigen administratie.</strong> Dezelfde gegevens onderbouwen
      het <a href="/urencriterium/">urencriterium</a> richting de Belastingdienst.</span>
    </li>
  </ul>

  <h2>Checklist: dit hoort erop</h2>
  <ol class="check-grid">
    <li>Je naam of bedrijfsnaam</li>
    <li>Naam van de klant of opdrachtgever</li>
    <li>Periode waarover de urenstaat gaat</li>
    <li>Per regel: datum, project, omschrijving en duur</li>
    <li>Totaal aantal uren</li>
    <li>Optioneel: uurtarief en bedrag per regel plus totaalbedrag</li>
  </ol>

  <h2>Zo vul je de urenstaat in</h2>
  <ol>
    <li>Vul jouw bedrijfsnaam, de opdrachtgever, het project en de periode in.</li>
    <li>Noteer per regel de datum en een concrete omschrijving van het werk.</li>
    <li>Vul de gewerkte duur in als decimale uren. Trek pauzes waarin je niet werkt eerst af.</li>
    <li>Vul het afgesproken uurtarief exclusief btw in. Excel rekent uren maal tarief uit en telt de regels op.</li>
    <li>Controleer het totaal met je agenda of timer en bewaar een kopie voordat je de urenstaat deelt.</li>
  </ol>
  <h3>Minuten omrekenen naar uren</h3>
  <div class="table-scroll"><table><caption>Veelgebruikte tijdsduren</caption><thead><tr><th scope="col">Duur</th><th scope="col" class="num">Decimale uren</th></tr></thead><tbody><tr><td>15 minuten</td><td class="num strong">0,25</td></tr><tr><td>30 minuten</td><td class="num strong">0,50</td></tr><tr><td>45 minuten</td><td class="num strong">0,75</td></tr><tr><td>1 uur en 30 minuten</td><td class="num strong">1,50</td></tr><tr><td>8 uur aanwezig, 30 minuten pauze</td><td class="num strong">7,50</td></tr></tbody></table></div>
  <p>Een urenstaat beschrijft je werk. Voor de betaling maak je een factuur met de bijbehorende gegevens. Bekijk <a href="/uren-factureren/">hoe je uren omzet in een factuur</a>.</p>
  <h2>Je urenstaat bijhouden in Uurwerk</h2>
  <figure class="guide-figure"><div class="iphone"><Image src={hoursImage} alt="Uurwerk urenoverzicht met urenregels, klant, project, totaal uren en bedrag" width={230} widths={[230, 460]} sizes="230px" format="webp" loading="lazy" /></div><figcaption>In Uurwerk bekijk je de geregistreerde uren en bedragen per periode. De Excel- en PDF-sjablonen hierboven zijn losse downloads voor je eigen administratie.</figcaption></figure>
  <p>
    Een urenstaat die je aan het einde van de maand &ldquo;maakt&rdquo;, is eigenlijk een
    reconstructie, en dat kost tijd en precisie. Draai het om: registreer elke werksessie
    direct, met klant, project en omschrijving. De urenstaat is dan geen document dat je bouwt,
    maar een filter dat je toepast: kies de klant en de periode, en alle regels staan er al.
  </p>
  <p>
    Zo werkt het in Uurwerk: je urenregels staan per klant en project vast, met datum,
    omschrijving, duur en bedrag. In het urenoverzicht filter je op deze week, deze maand of een
    eigen periode. Diezelfde openstaande uren zet je vervolgens met een paar tikken om in een
    conceptfactuur met btw, als PDF klaar voor je klant. Factuur en specificatie komen zo altijd
    uit dezelfde bron, zonder overtypen. Meer weten? Lees
    ook <a href="/urenregistratie-zzp/">urenregistratie voor zzp&rsquo;ers</a>.
  </p>
  <p>Wil je zelf een spreadsheet opzetten of een formule controleren? Bekijk de <a href="/urenregistratie-excel/">Excel-uitleg voor urenregistratie</a>, met voorbeelden voor pauzes en decimale uren.</p>
</Guide>
