---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  schemas?: object[];
}

const { title, description, h1, schemas } = Astro.props;
---

<Base title={title} description={description} schemas={schemas}>
  <article class="page">
    <header class="article-head">
      <div class="container">
        <nav class="breadcrumb" aria-label="Kruimelpad">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">{h1}</li>
          </ol>
        </nav>
        <h1>{h1}</h1>
      </div>
    </header>
    <div class="container page-body">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .page-body {
    padding-top: 64px;
    padding-bottom: 120px;
  }

  @media (max-width: 767px) {
    .page-body {
      padding-top: 28px;
      padding-bottom: 72px;
    }
  }
</style>
